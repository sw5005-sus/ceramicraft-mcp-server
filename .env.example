# ─── MCP Server ────────────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# ─── Internal HTTP Endpoints ──────────────────────────────────────────────
# Local dev: use localhost with mapped ports from docker-compose.
# In cluster: defaults in config.py point to K8s service DNS (e.g. product-ms-svc:8080).
PRODUCT_MS_HTTP=http://localhost:8081
ORDER_MS_HTTP=http://localhost:8082
USER_MS_HTTP=http://localhost:8083
COMMENT_MS_HTTP=http://localhost:8084
PAYMENT_MS_HTTP=http://localhost:8085
NOTIFICATION_MS_HTTP=http://localhost:8087

# ─── Zitadel (MCP-prefixed to avoid conflict with other services) ─────────
MCP_ZITADEL_ISSUER=https://cerami-t6ihrd.us1.zitadel.cloud
MCP_ZITADEL_JWKS_URL=https://cerami-t6ihrd.us1.zitadel.cloud/oauth/v2/keys
